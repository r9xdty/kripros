# Supabase → Project Settings → API (Data API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "anon" / "publishable" key — safe to ship in the app; data is protected by row level security
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Development only: run without Supabase using local demo data
# EXPO_PUBLIC_DEMO_MODE=1
